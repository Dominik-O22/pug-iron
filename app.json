{
  "expo": {
    "name": "Pug Iron",
    "slug": "pug-iron",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#0C1210",
    "android": {
      "package": "com.doop.pugiron",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131C1A"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C1210"
        }
      ]
    ]
  }
}

{
  "expo": {
    "name": "Pug Iron",
    "slug": "pug-iron",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#0C1210",
    "android": {
      "package": "com.doop.pugiron",
      "blockedPermissions": ["android.permission.CHANGE_WIFI_MULTICAST_STATE"],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131C1A"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to hear rep counts during a workout.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize spoken rep counts.",
          "androidSpeechServicePackages": ["com.google.android.as"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C1210"
        }
      ]
    ]
  }
}
